# ---------------------------------------------------------------------------
# Deep Scrubber environment template. Copy to .env and fill in.
# Generate secrets with: npm run keys:generate
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# API
API_HOST=0.0.0.0
API_PORT=4000
PUBLIC_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=false
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com
SESSION_TTL_HOURS=336
REQUIRE_EMAIL_VERIFICATION=true
ADMIN_REQUIRE_MFA=true

# Data stores
DATABASE_URL=postgres://postgres:postgres@localhost:5432/deepscrubber
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
QUEUE_DRIVER=bullmq
RATE_LIMIT_DRIVER=redis

# Encryption (REQUIRED). Key ring format: id:base64(32 bytes)[,id:base64...]
ENCRYPTION_KEYS=v1:REPLACE_ME
ENCRYPTION_ACTIVE_KEY_ID=v1
BLIND_INDEX_KEY=REPLACE_ME
LOG_HASH_KEY=REPLACE_ME

# Search providers (authorized APIs only): comma list of brave,google,fixture
SEARCH_PROVIDERS=fixture
SEARCH_FIXTURE_FILE=providers/search/fixtures.dev.json
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# AI (optional; deterministic fallbacks are used when "none")
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# Mail
MAIL_TRANSPORT=log
SMTP_URL=
MAIL_FROM="Deep Scrubber <no-reply@example.com>"
REMOVAL_REPLY_TO_DOMAIN=relay.example.com
INBOUND_EMAIL_SECRET=

# Web push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:privacy@example.com

# Outbound fetch safety
FETCH_TIMEOUT_MS=10000
FETCH_MAX_BYTES=2000000
FETCH_ALLOWED_PORTS=80,443
# Development only — lets agents reach the local mock broker. Must be empty in production.
FETCH_ALLOWLIST_PRIVATE_HOSTS=127.0.0.1
EXAMPLE_BROKER_BASE_URL=http://127.0.0.1:4545

# Retention
TEMP_DOCUMENT_TTL_HOURS=24
DEFAULT_RECORD_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=400
STORAGE_DIR=./var/storage

# Provider health circuit breaker
PROVIDER_FAILURE_THRESHOLD=0.25
PROVIDER_MIN_SAMPLES=8

# Billing: disabled | dev (dev lets users switch plans without payment; never in production)
BILLING_MODE=disabled
